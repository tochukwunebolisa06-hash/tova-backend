# Copy this to .env for local development. On Railway, don't add these as
# files — set them as environment variables in the service's Variables tab
# instead (DATABASE_URL is set for you automatically once Postgres is linked).

SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset locally to use sqlite. Railway sets this for you.
# DATABASE_URL=postgresql://user:password@host:port/dbname
